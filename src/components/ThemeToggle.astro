<div class="site-theme-control">
  <button
    type="button"
    class="site-theme-toggle"
    data-theme-toggle
    data-tippy-placement="left"
    aria-label="Switch to dark mode"
    aria-pressed="false"
    title="Switch to dark mode"
  >
    <span class="site-theme-icon site-theme-icon--moon i-mdi-weather-night" aria-hidden="true"></span>
    <span class="site-theme-icon site-theme-icon--sun i-mdi-white-balance-sunny" aria-hidden="true"></span>
  </button>
</div>
