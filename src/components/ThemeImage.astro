---
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type { HTMLAttributes } from 'astro/types'

type Props = Omit<HTMLAttributes<'img'>, 'src' | 'width' | 'height'> & {
  lightSrc: ImageMetadata
  darkSrc: ImageMetadata
  alt: string
}

const {
  lightSrc,
  darkSrc,
  alt,
  class: className,
  loading = 'lazy',
  decoding = 'async',
  ...attrs
} = Astro.props

const [lightImage, darkImage] = await Promise.all([
  getImage({ src: lightSrc, format: 'webp' }),
  getImage({ src: darkSrc, format: 'webp' }),
])
---

<img
  src={lightImage.src}
  width={lightSrc.width}
  height={lightSrc.height}
  alt={alt}
  class={className}
  loading={loading}
  decoding={decoding}
  data-theme-image
  data-theme-src-light={lightImage.src}
  data-theme-src-dark={darkImage.src}
  {...attrs}
/>
<script is:inline>
  (() => {
    const image = document.currentScript?.previousElementSibling;
    if (!(image instanceof HTMLImageElement)) return;

    const theme = document.documentElement.dataset.theme;
    const source = theme === 'dark'
      ? image.dataset.themeSrcDark
      : image.dataset.themeSrcLight;
    if (source) image.src = source;
  })();
</script>
